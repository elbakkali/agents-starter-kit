parameters:
    level: 5
    paths:
        - app
        - config
        - database
        - routes
    excludePaths:
        - vendor
        - storage
        - bootstrap/cache
        - tests/Architecture/ArchTest.php.template

includes:
    - vendor/larastan/larastan/extension.neon

# Larastan-ready stub — active after Laravel scaffold:
#
#   composer require --dev larastan/larastan
#   cp phpstan.neon.dist phpstan.neon
#
# Architecture tests (optional):
#   cp tests/Architecture/ArchTest.php.template tests/Architecture/ArchTest.php
#
# Run (native): ./vendor/bin/phpstan analyse --configuration=phpstan.neon.dist
# Run (devkit): python3 -m scripts.tasks.static_analysis
